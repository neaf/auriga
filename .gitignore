# Upstream source clones (pinned commits are documented in README.md)
/openauto/
/aasdk-upstream/

# Build outputs
/build-*/
/.build-from-patches/
*.o
*.so

# python venv for the stream server
/.venv/

# Serena tool state (local project config/cache)
/.serena/

# macOS captures (large media, local only)
/captures-mac/

# OpenAuto file log (cwd of openauto-config)
/openauto-config/openauto.log

# Large capture media (kept locally for analysis)
/captures/*.h264
/captures/*.mp4
/captures/*.wav
/captures/*.png

# Runtime logs
/logs/*.log

# Locally built APKs (AARE fork)
/artifacts/

# Re-architect run state
/.rearch/

# Input traces
*.jsonl

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Local Android Auto phone identity (private key; never commit)
/daxter-certs/

# Dongle credential databases (link keys; kept locally only)
/dongle-backup/*.db
/dongle-backup/*.db.*
/dongle-backup/*.bk
/dongle-backup/*.bk.*
/posttrip/
/btapp.db*
/btapp.bk*

# Runtime PID files
*.pid
