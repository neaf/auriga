+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture output: writes each AA audio channel to its own WAV file in
+*  the current session directory. Selected only when AURIGA_CAPTURE_DIR is set.
+*  The AA callback only queues a copy; a writer thread does the file I/O and the
+*  WAV header rewrite.
+*/
+
+#pragma once
+
+#include <cstdint>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <f1x/openauto/autoapp/Projection/AurigaSession.hpp>
+#include <f1x/openauto/autoapp/Projection/AurigaWriter.hpp>
+#include <f1x/openauto/autoapp/Projection/IAudioOutput.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+class AurigaAudioOutput : public IAudioOutput
+{
+public:
+    AurigaAudioOutput(std::shared_ptr<AurigaSessionManager> session, std::string name,
+                      uint32_t channelCount, uint32_t sampleSize, uint32_t sampleRate);
+    ~AurigaAudioOutput() override;
+
+    bool open() override;
+    void write(aasdk::messenger::Timestamp::ValueType timestamp,
+               const aasdk::common::DataConstBuffer& buffer) override;
+    void setCodecConfig(const aasdk::common::DataConstBuffer& buffer) override;
+    void start() override;
+    void stop() override;
+    void suspend() override;
+
+    uint32_t getSampleSize() const override;
+    uint32_t getChannelCount() const override;
+    uint32_t getSampleRate() const override;
+
+private:
+    // Run on the writer thread only.
+    void writeChunk(const std::vector<uint8_t>& chunk);
+    void writeHeader();
+    void updateHeader();
+    void rotate();
+
+    std::shared_ptr<AurigaSessionManager> session_;
+    std::string stream_;
+    std::string path_;
+    std::ofstream file_;
+    uint32_t channelCount_;
+    uint32_t sampleSize_;
+    uint32_t sampleRate_;
+    uint64_t dataBytes_;
+    uint64_t lastHeaderUpdate_;
+    bool accepting_;
+    // Declared last: its destructor joins the writer thread before the file is
+    // destroyed.
+    AurigaWriter writer_;
+};
+
+}
+}
+}
+}
