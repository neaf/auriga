@@ -0,0 +1,253 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture output: appends H.264 Annex-B access units to the current
+*  session's video.h264, rotating to a new segment before 4 GiB.
+*/
+
+#include <utility>
+
+#include <f1x/openauto/Common/Log.hpp>
+#include <f1x/openauto/autoapp/Projection/AurigaVideoOutput.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+AurigaVideoOutput::AurigaVideoOutput(configuration::IConfiguration::Pointer configuration,
+                                     std::shared_ptr<AurigaSessionManager> session)
+    : VideoOutput(std::move(configuration))
+    , session_(std::move(session))
+    , path_(session_->path("video.h264"))
+    , codecConfigPending_(false)
+    , segmentBytes_(0)
+    , segmentStarted_(false)
+    , codecConfigWritten_(false)
+    , awaitingKeyframe_(false)
+    , warnedMissingConfig_(false)
+    , accepting_(false)
+    , writer_("video", [this](const std::vector<uint8_t>& chunk) { this->writeChunk(chunk); })
+{
+}
+
+AurigaVideoOutput::~AurigaVideoOutput()
+{
+    this->stop();
+}
+
+bool AurigaVideoOutput::open()
+{
+    if (file_.is_open())
+    {
+        return true;
+    }
+
+    file_.open(path_, std::ios::binary | std::ios::trunc);
+    if (!file_.is_open())
+    {
+        OPENAUTO_LOG(error) << "[AurigaVideoOutput] cannot open " << path_;
+        accepting_ = false;
+        return false;
+    }
+
+    segmentBytes_ = 0;
+    segmentStarted_ = false;
+    codecConfigWritten_ = false;
+    awaitingKeyframe_ = false;
+    warnedMissingConfig_ = false;
+    accepting_ = true;
+    writer_.start();
+
+    OPENAUTO_LOG(info) << "[AurigaVideoOutput] writing " << path_ << " (session "
+                       << session_->sessionId() << ")";
+    return true;
+}
+
+bool AurigaVideoOutput::init()
+{
+    return true;
+}
+
+// Channel strand: copy only. The writer thread owns the file from here on.
+void AurigaVideoOutput::write(aasdk::messenger::Timestamp::ValueType,
+                              const aasdk::common::DataConstBuffer& buffer)
+{
+    if (!accepting_)
+    {
+        return;
+    }
+
+    writer_.append(buffer);
+}
+
+// MEDIA_MESSAGE_CODEC_CONFIG. Cached, never mixed into the media bytes; it is
+// written once at the head of the current or next segment. When the phone sends
+// it after the first access unit (config ordering is not guaranteed), the writer
+// thread appends it at the current offset instead of losing it for the segment.
+void AurigaVideoOutput::setCodecConfig(const aasdk::common::DataConstBuffer& buffer)
+{
+    if (buffer.cdata == nullptr || buffer.size == 0)
+    {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(codecConfigMutex_);
+    codecConfig_.assign(buffer.cdata, buffer.cdata + buffer.size);
+    codecConfigPending_ = true;
+
+    OPENAUTO_LOG(info) << "[AurigaVideoOutput] codec config " << codecConfig_.size()
+                       << " bytes (written at the head of the segment)";
+}
+
+void AurigaVideoOutput::stop()
+{
+    accepting_ = false;
+    writer_.stop();
+
+    if (file_.is_open())
+    {
+        file_.flush();
+        file_.close();
+        OPENAUTO_LOG(info) << "[AurigaVideoOutput] closed " << path_ << " ("
+                           << writer_.dropped() << " dropped)";
+    }
+}
+
+namespace
+{
+
+// True when the access unit carries an IDR slice (NAL type 5), i.e. a point a
+// decoder can restart from.
+bool containsIdr(const std::vector<uint8_t>& data)
+{
+    for (size_t i = 0; i + 3 < data.size(); ++i)
+    {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1 && (data[i + 3] & 0x1F) == 5)
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+}
+
+// Writer thread. Codec config goes in front of the first access unit of a
+// segment, so every segment starts with SPS/PPS. A queue overflow means a chunk
+// was lost; deltas that follow it reference a missing frame, so they are skipped
+// until the next IDR, which is prefixed with SPS/PPS again. Dropping beats
+// writing an undecodable reference chain, and the stream server sees the IDR as
+// the resync point (`AurigaWriter::take_drop_flag`).
+void AurigaVideoOutput::writeChunk(const std::vector<uint8_t>& chunk)
+{
+    if (!file_.is_open())
+    {
+        return;
+    }
+
+    if (writer_.take_drop_flag())
+    {
+        if (!awaitingKeyframe_)
+        {
+            OPENAUTO_LOG(warning) << "[AurigaVideoOutput] queue overflow, skipping deltas "
+                                     "until the next IDR";
+        }
+        awaitingKeyframe_ = true;
+    }
+
+    if (awaitingKeyframe_)
+    {
+        if (!containsIdr(chunk))
+        {
+            return;
+        }
+        awaitingKeyframe_ = false;
+        // Restart the segment head so the IDR is preceded by SPS/PPS.
+        segmentStarted_ = false;
+        codecConfigWritten_ = false;
+    }
+
+    if (!segmentStarted_)
+    {
+        segmentStarted_ = true;
+        this->writeCachedCodecConfig();
+        if (!codecConfigWritten_ && !warnedMissingConfig_)
+        {
+            warnedMissingConfig_ = true;
+            OPENAUTO_LOG(warning) << "[AurigaVideoOutput] media before codec config; "
+                                     "the segment head has no SPS/PPS yet";
+        }
+    }
+    else if (codecConfigPending_)
+    {
+        const uint64_t offset = segmentBytes_;
+        if (this->writeCachedCodecConfig())
+        {
+            OPENAUTO_LOG(warning) << "[AurigaVideoOutput] codec config arrived after the "
+                                     "first access unit; appended at offset " << offset;
+        }
+    }
+
+    file_.write(reinterpret_cast<const char*>(chunk.data()),
+                static_cast<std::streamsize>(chunk.size()));
+    file_.flush();
+    segmentBytes_ += chunk.size();
+
+    if (segmentBytes_ >= AurigaSessionManager::SEGMENT_LIMIT)
+    {
+        this->rotate();
+    }
+}
+
+bool AurigaVideoOutput::writeCachedCodecConfig()
+{
+    std::vector<uint8_t> config;
+    {
+        std::lock_guard<std::mutex> lock(codecConfigMutex_);
+        config = codecConfig_;
+        codecConfigPending_ = false;
+    }
+
+    if (config.empty())
+    {
+        return false;
+    }
+
+    file_.write(reinterpret_cast<const char*>(config.data()),
+                static_cast<std::streamsize>(config.size()));
+    file_.flush();
+    segmentBytes_ += config.size();
+    codecConfigWritten_ = true;
+    return true;
+}
+
+// Segment rollover: the same file restarts at offset 0 and the manifest count
+// advances, which is the stream server's signal to reopen it. Writer thread.
+void AurigaVideoOutput::rotate()
+{
+    file_.flush();
+    file_.close();
+    file_.open(path_, std::ios::binary | std::ios::trunc);
+    segmentBytes_ = 0;
+    segmentStarted_ = false;
+    codecConfigWritten_ = false;
+    awaitingKeyframe_ = false;
+
+    if (!file_.is_open())
+    {
+        OPENAUTO_LOG(error) << "[AurigaVideoOutput] cannot reopen " << path_;
+        return;
+    }
+
+    session_->noteRotation("video");
+}
+
+}
+}
+}
+}
