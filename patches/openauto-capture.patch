+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture input: reads touch commands from stdin/FIFO, logs them as
+*  JSONL and forwards them to the AA input channel. Replaces the Qt widget
+*  based InputDevice when AURIGA_CAPTURE_DIR is set.
+*/
+
+#pragma once
+
+#include <atomic>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include <QRect>
+
+#include <f1x/openauto/autoapp/Projection/IInputDevice.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+class AurigaInputDevice : public IInputDevice
+{
+public:
+    AurigaInputDevice(std::string jsonlPath, QRect touchscreenGeometry);
+    ~AurigaInputDevice() override;
+
+    void start(IInputDeviceEventHandler& eventHandler) override;
+    void stop() override;
+    ButtonCodes getSupportedButtonCodes() const override;
+    bool hasTouchscreen() const override;
+    QRect getTouchscreenGeometry() const override;
+
+private:
+    void readerLoop();
+    void handleCommand(const std::string& line);
+    void sendTouch(aap_protobuf::service::inputsource::message::PointerAction action,
+                   uint32_t x, uint32_t y);
+    void logEvent(const std::string& command, uint32_t x, uint32_t y);
+
+    std::string jsonlPath_;
+    QRect touchscreenGeometry_;
+    IInputDeviceEventHandler* eventHandler_;
+    std::ofstream log_;
+    std::mutex mutex_;
+    std::atomic<bool> running_;
+    std::thread reader_;
+    std::string pending_;
+};
+
+}
