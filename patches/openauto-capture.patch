diff --git a/src/autoapp/Projection/AurigaAudioInput.cpp b/src/autoapp/Projection/AurigaAudioInput.cpp
new file mode 100644
index 0000000..4b48c23
--- /dev/null
+++ b/src/autoapp/Projection/AurigaAudioInput.cpp
@@ -0,0 +1,132 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture input: paced silence for the microphone channel.
+*/
+
+#include <f1x/openauto/Common/Log.hpp>
+#include <f1x/openauto/autoapp/Projection/AurigaAudioInput.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+AurigaAudioInput::AurigaAudioInput(boost::asio::io_service& ioService, uint32_t channelCount,
+                                   uint32_t sampleSize, uint32_t sampleRate)
+    : timer_(ioService)
+    , active_(false)
+    , channelCount_(channelCount)
+    , sampleSize_(sampleSize)
+    , sampleRate_(sampleRate)
+{
+}
+
+AurigaAudioInput::~AurigaAudioInput()
+{
+    this->stop();
+}
+
+bool AurigaAudioInput::open()
+{
+    return true;
+}
+
+bool AurigaAudioInput::isActive() const
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    return active_;
+}
+
+void AurigaAudioInput::start(StartPromise::Pointer promise)
+{
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        active_ = true;
+    }
+
+    OPENAUTO_LOG(info) << "[AurigaAudioInput] silent microphone started";
+    promise->resolve();
+}
+
+void AurigaAudioInput::read(ReadPromise::Pointer promise)
+{
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+
+        if (!active_ || readPromise_ != nullptr)
+        {
+            promise->reject();
+            return;
+        }
+
+        readPromise_ = std::move(promise);
+    }
+
+    auto self = this->shared_from_this();
+    timer_.expires_from_now(boost::posix_time::milliseconds(20));
+    timer_.async_wait([self](const boost::system::error_code& error) {
+        if (error)
+        {
+            return;
+        }
+
+        ReadPromise::Pointer pending;
+        {
+            std::lock_guard<std::mutex> lock(self->mutex_);
+            pending = std::move(self->readPromise_);
+        }
+
+        if (pending == nullptr)
+        {
+            return;
+        }
+
+        const size_t bytes = static_cast<size_t>(self->sampleRate_ / 50) *
+                             self->channelCount_ * (self->sampleSize_ / 8);
+        aasdk::common::Data data(bytes, 0);
+        pending->resolve(std::move(data));
+    });
+}
+
+void AurigaAudioInput::stop()
+{
+    ReadPromise::Pointer pending;
+
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        active_ = false;
+        pending = std::move(readPromise_);
+    }
+
+    timer_.cancel();
+
+    if (pending != nullptr)
+    {
+        pending->reject();
+    }
+}
+
+uint32_t AurigaAudioInput::getSampleSize() const
+{
+    return sampleSize_;
+}
+
+uint32_t AurigaAudioInput::getChannelCount() const
+{
+    return channelCount_;
+}
+
+uint32_t AurigaAudioInput::getSampleRate() const
+{
+    return sampleRate_;
+}
+
+}
+}
+}
+}
diff --git a/src/autoapp/Projection/AurigaAudioOutput.cpp b/src/autoapp/Projection/AurigaAudioOutput.cpp
new file mode 100644
index 0000000..6d11b1d
--- /dev/null
+++ b/src/autoapp/Projection/AurigaAudioOutput.cpp
@@ -0,0 +1,237 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture output: PCM WAV writer with a segment cap.
+*/
+
+#include <utility>
+
+#include <f1x/openauto/Common/Log.hpp>
+#include <f1x/openauto/autoapp/Projection/AurigaAudioOutput.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+namespace
+{
+
+void writeLE16(std::ofstream& file, uint16_t value)
+{
+    char bytes[2] = { static_cast<char>(value & 0xff),
+                      static_cast<char>((value >> 8) & 0xff) };
+    file.write(bytes, sizeof(bytes));
+}
+
+void writeLE32(std::ofstream& file, uint32_t value)
+{
+    char bytes[4] = { static_cast<char>(value & 0xff),
+                      static_cast<char>((value >> 8) & 0xff),
+                      static_cast<char>((value >> 16) & 0xff),
+                      static_cast<char>((value >> 24) & 0xff) };
+    file.write(bytes, sizeof(bytes));
+}
+
+void writeFourCC(std::ofstream& file, const char* value)
+{
+    file.write(value, 4);
+}
+
+}
+
+AurigaAudioOutput::AurigaAudioOutput(std::shared_ptr<AurigaSessionManager> session, std::string name,
+                                     uint32_t channelCount, uint32_t sampleSize, uint32_t sampleRate)
+    : session_(std::move(session))
+    , stream_("audio-" + name)
+    , path_(session_->path("audio-" + name + ".wav"))
+    , channelCount_(channelCount)
+    , sampleSize_(sampleSize)
+    , sampleRate_(sampleRate)
+    , dataBytes_(0)
+    , lastHeaderUpdate_(0)
+    , accepting_(false)
+    , writer_(stream_, [this](const std::vector<uint8_t>& chunk) { this->writeChunk(chunk); })
+{
+}
+
+AurigaAudioOutput::~AurigaAudioOutput()
+{
+    this->stop();
+}
+
+bool AurigaAudioOutput::open()
+{
+    if (file_.is_open())
+    {
+        return true;
+    }
+
+    file_.open(path_, std::ios::binary | std::ios::trunc);
+    if (!file_.is_open())
+    {
+        OPENAUTO_LOG(error) << "[AurigaAudioOutput] cannot open " << path_;
+        accepting_ = false;
+        return false;
+    }
+
+    dataBytes_ = 0;
+    lastHeaderUpdate_ = 0;
+    this->writeHeader();
+    accepting_ = true;
+    writer_.start();
+
+    OPENAUTO_LOG(info) << "[AurigaAudioOutput] writing " << path_ << " ("
+                       << sampleRate_ << " Hz, " << channelCount_ << " ch, "
+                       << sampleSize_ << " bit, session " << session_->sessionId() << ")";
+    return true;
+}
+
+// Channel strand: copy only. The writer thread owns the file from here on.
+void AurigaAudioOutput::write(aasdk::messenger::Timestamp::ValueType,
+                              const aasdk::common::DataConstBuffer& buffer)
+{
+    if (!accepting_)
+    {
+        return;
+    }
+
+    writer_.append(buffer);
+}
+
+// MEDIA_MESSAGE_CODEC_CONFIG carries the PCM format, not media bytes; the WAV
+// header already describes the stream, so nothing is written into the file.
+void AurigaAudioOutput::setCodecConfig(const aasdk::common::DataConstBuffer& buffer)
+{
+    OPENAUTO_LOG(debug) << "[AurigaAudioOutput] codec config " << buffer.size
+                        << " bytes ignored (" << stream_ << " is raw PCM)";
+}
+
+void AurigaAudioOutput::start()
+{
+}
+
+void AurigaAudioOutput::stop()
+{
+    accepting_ = false;
+    writer_.stop();
+
+    if (file_.is_open())
+    {
+        this->updateHeader();
+        file_.flush();
+        file_.close();
+        OPENAUTO_LOG(info) << "[AurigaAudioOutput] closed " << path_ << " ("
+                           << writer_.dropped() << " dropped)";
+    }
+}
+
+void AurigaAudioOutput::suspend()
+{
+}
+
+uint32_t AurigaAudioOutput::getSampleSize() const
+{
+    return sampleSize_;
+}
+
+uint32_t AurigaAudioOutput::getChannelCount() const
+{
+    return channelCount_;
+}
+
+uint32_t AurigaAudioOutput::getSampleRate() const
+{
+    return sampleRate_;
+}
+
+// Writer thread.
+void AurigaAudioOutput::writeChunk(const std::vector<uint8_t>& chunk)
+{
+    if (!file_.is_open())
+    {
+        return;
+    }
+
+    file_.write(reinterpret_cast<const char*>(chunk.data()),
+                static_cast<std::streamsize>(chunk.size()));
+    dataBytes_ += chunk.size();
+
+    if (dataBytes_ >= AurigaSessionManager::SEGMENT_LIMIT)
+    {
+        this->rotate();
+        return;
+    }
+
+    const uint64_t bytesPerSecond =
+        static_cast<uint64_t>(sampleRate_) * channelCount_ * (sampleSize_ / 8);
+    if (bytesPerSecond > 0 && dataBytes_ - lastHeaderUpdate_ >= bytesPerSecond)
+    {
+        this->updateHeader();
+    }
+}
+
+void AurigaAudioOutput::writeHeader()
+{
+    file_.seekp(0);
+
+    writeFourCC(file_, "RIFF");
+    writeLE32(file_, static_cast<uint32_t>(36 + dataBytes_));
+    writeFourCC(file_, "WAVE");
+
+    writeFourCC(file_, "fmt ");
+    writeLE32(file_, 16);
+    writeLE16(file_, 1); // PCM
+    writeLE16(file_, static_cast<uint16_t>(channelCount_));
+    writeLE32(file_, sampleRate_);
+    writeLE32(file_, sampleRate_ * channelCount_ * (sampleSize_ / 8));
+    writeLE16(file_, static_cast<uint16_t>(channelCount_ * (sampleSize_ / 8)));
+    writeLE16(file_, static_cast<uint16_t>(sampleSize_));
+
+    writeFourCC(file_, "data");
+    writeLE32(file_, static_cast<uint32_t>(dataBytes_));
+
+    file_.seekp(0, std::ios::end);
+}
+
+void AurigaAudioOutput::updateHeader()
+{
+    if (!file_.is_open())
+    {
+        return;
+    }
+
+    this->writeHeader();
+    lastHeaderUpdate_ = dataBytes_;
+}
+
+// Segment rollover: the WAV restarts at 44 bytes with a fresh header and the
+// manifest count advances, which is the stream server's signal to reopen it.
+// Writer thread.
+void AurigaAudioOutput::rotate()
+{
+    file_.flush();
+    file_.close();
+    file_.open(path_, std::ios::binary | std::ios::trunc);
+
+    dataBytes_ = 0;
+    lastHeaderUpdate_ = 0;
+
+    if (!file_.is_open())
+    {
+        OPENAUTO_LOG(error) << "[AurigaAudioOutput] cannot reopen " << path_;
+        return;
+    }
+
+    this->writeHeader();
+    session_->noteRotation(stream_);
+}
+
+}
+}
+}
+}
diff --git a/src/autoapp/Projection/AurigaInputDevice.cpp b/src/autoapp/Projection/AurigaInputDevice.cpp
new file mode 100644
index 0000000..db53245
--- /dev/null
+++ b/src/autoapp/Projection/AurigaInputDevice.cpp
@@ -0,0 +1,273 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture input: stdin/FIFO touch injection and JSONL logging.
+*/
+
+#include <chrono>
+#include <poll.h>
+#include <sstream>
+#include <thread>
+#include <unistd.h>
+
+#include <aap_protobuf/service/inputsource/message/PointerAction.pb.h>
+#include <aap_protobuf/service/media/sink/message/KeyCode.pb.h>
+
+#include <f1x/openauto/Common/Log.hpp>
+#include <f1x/openauto/autoapp/Projection/AurigaInputDevice.hpp>
+#include <f1x/openauto/autoapp/Projection/IInputDeviceEventHandler.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+namespace
+{
+
+// A line is `tap|down|move|up X Y`; anything longer is a runaway writer.
+constexpr size_t MAX_PENDING = 64 * 1024;
+
+}
+
+AurigaInputDevice::AurigaInputDevice(std::string jsonlPath, QRect touchscreenGeometry)
+    : jsonlPath_(std::move(jsonlPath))
+    , touchscreenGeometry_(std::move(touchscreenGeometry))
+    , eventHandler_(nullptr)
+    , running_(false)
+{
+}
+
+AurigaInputDevice::~AurigaInputDevice()
+{
+    this->stop();
+}
+
+void AurigaInputDevice::start(IInputDeviceEventHandler& eventHandler)
+{
+    // `quit` (or stdin EOF) ends the reader loop without `stop()`. A second
+    // KeyBindingRequest must not assign over a joinable thread (std::terminate)
+    // or reopen a stream that is already open (failbit, silent log loss).
+    running_ = false;
+    if (reader_.joinable())
+    {
+        reader_.join();
+    }
+
+    if (running_.exchange(true))
+    {
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        eventHandler_ = &eventHandler;
+    }
+
+    if (!log_.is_open())
+    {
+        log_.open(jsonlPath_, std::ios::out | std::ios::trunc);
+    }
+    if (!log_.is_open())
+    {
+        OPENAUTO_LOG(warning) << "[AurigaInputDevice] cannot open " << jsonlPath_;
+    }
+
+    OPENAUTO_LOG(info) << "[AurigaInputDevice] reading touch commands from stdin, log "
+                       << jsonlPath_;
+    reader_ = std::thread([this]() { this->readerLoop(); });
+}
+
+void AurigaInputDevice::stop()
+{
+    running_ = false;
+
+    if (reader_.joinable())
+    {
+        reader_.join();
+    }
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    eventHandler_ = nullptr;
+
+    if (log_.is_open())
+    {
+        log_.flush();
+        log_.close();
+    }
+}
+
+IInputDevice::ButtonCodes AurigaInputDevice::getSupportedButtonCodes() const
+{
+    using aap_protobuf::service::media::sink::message::KeyCode;
+
+    return {
+        KeyCode::KEYCODE_HOME,
+        KeyCode::KEYCODE_BACK,
+        KeyCode::KEYCODE_MENU,
+        KeyCode::KEYCODE_APP_SWITCH,
+        KeyCode::KEYCODE_DPAD_UP,
+        KeyCode::KEYCODE_DPAD_DOWN,
+        KeyCode::KEYCODE_DPAD_LEFT,
+        KeyCode::KEYCODE_DPAD_RIGHT,
+        KeyCode::KEYCODE_DPAD_CENTER,
+        KeyCode::KEYCODE_MEDIA_PLAY,
+        KeyCode::KEYCODE_MEDIA_PAUSE,
+        KeyCode::KEYCODE_MEDIA_PLAY_PAUSE,
+        KeyCode::KEYCODE_MEDIA_STOP,
+        KeyCode::KEYCODE_MEDIA_NEXT,
+        KeyCode::KEYCODE_MEDIA_PREVIOUS,
+        KeyCode::KEYCODE_MEDIA_FAST_FORWARD,
+        KeyCode::KEYCODE_MEDIA_REWIND,
+        KeyCode::KEYCODE_CALL,
+        KeyCode::KEYCODE_ENDCALL,
+        KeyCode::KEYCODE_SEARCH,
+        KeyCode::KEYCODE_ASSIST,
+        KeyCode::KEYCODE_VOICE_ASSIST,
+        KeyCode::KEYCODE_NAVIGATION,
+        KeyCode::KEYCODE_ROTARY_CONTROLLER
+    };
+}
+
+bool AurigaInputDevice::hasTouchscreen() const
+{
+    return true;
+}
+
+QRect AurigaInputDevice::getTouchscreenGeometry() const
+{
+    return touchscreenGeometry_;
+}
+
+void AurigaInputDevice::readerLoop()
+{
+    while (running_)
+    {
+        struct pollfd descriptor;
+        descriptor.fd = STDIN_FILENO;
+        descriptor.events = POLLIN;
+        descriptor.revents = 0;
+
+        const int ready = ::poll(&descriptor, 1, 200);
+        if (ready <= 0 || (descriptor.revents & POLLIN) == 0)
+        {
+            continue;
+        }
+
+        char buffer[4096];
+        const ssize_t count = ::read(STDIN_FILENO, buffer, sizeof(buffer));
+        if (count <= 0)
+        {
+            break;
+        }
+
+        pending_.append(buffer, static_cast<size_t>(count));
+        if (pending_.size() > MAX_PENDING)
+        {
+            // A writer that never sends a newline must not grow this forever.
+            OPENAUTO_LOG(warning) << "[AurigaInputDevice] discarding " << pending_.size()
+                                  << " bytes without a newline";
+            pending_.clear();
+        }
+
+        size_t newline;
+        while ((newline = pending_.find('\n')) != std::string::npos)
+        {
+            const std::string line = pending_.substr(0, newline);
+            pending_.erase(0, newline + 1);
+            this->handleCommand(line);
+        }
+    }
+}
+
+void AurigaInputDevice::handleCommand(const std::string& line)
+{
+    std::istringstream stream(line);
+    std::string command;
+    uint32_t x = 0;
+    uint32_t y = 0;
+
+    if (!(stream >> command))
+    {
+        return;
+    }
+
+    if (command == "tap" && (stream >> x >> y))
+    {
+        this->logEvent(command, x, y);
+        this->sendTouch(aap_protobuf::service::inputsource::message::PointerAction::ACTION_DOWN, x, y);
+        std::this_thread::sleep_for(std::chrono::milliseconds(80));
+        this->sendTouch(aap_protobuf::service::inputsource::message::PointerAction::ACTION_UP, x, y);
+    }
+    else if (command == "down" && (stream >> x >> y))
+    {
+        this->logEvent(command, x, y);
+        this->sendTouch(aap_protobuf::service::inputsource::message::PointerAction::ACTION_DOWN, x, y);
+    }
+    else if (command == "move" && (stream >> x >> y))
+    {
+        this->logEvent(command, x, y);
+        this->sendTouch(aap_protobuf::service::inputsource::message::PointerAction::ACTION_MOVED, x, y);
+    }
+    else if (command == "up" && (stream >> x >> y))
+    {
+        this->logEvent(command, x, y);
+        this->sendTouch(aap_protobuf::service::inputsource::message::PointerAction::ACTION_UP, x, y);
+    }
+    else if (command == "quit")
+    {
+        running_ = false;
+    }
+    else
+    {
+        OPENAUTO_LOG(warning) << "[AurigaInputDevice] unknown command: " << line;
+    }
+}
+
+void AurigaInputDevice::sendTouch(
+    aap_protobuf::service::inputsource::message::PointerAction action, uint32_t x, uint32_t y)
+{
+    IInputDeviceEventHandler* handler = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        handler = eventHandler_;
+    }
+
+    if (handler == nullptr)
+    {
+        OPENAUTO_LOG(warning) << "[AurigaInputDevice] touch ignored, handler not ready";
+        return;
+    }
+
+    TouchEvent event;
+    event.type = action;
+    event.actionIndex = 0;
+    event.pointers.push_back({x, y, 0});
+    handler->onTouchEvent(event);
+}
+
+void AurigaInputDevice::logEvent(const std::string& command, uint32_t x, uint32_t y)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+
+    if (!log_.is_open())
+    {
+        return;
+    }
+
+    const auto timestamp = std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::system_clock::now().time_since_epoch());
+
+    log_ << "{\"ts\":" << timestamp.count() << ",\"cmd\":\"" << command
+         << "\",\"x\":" << x << ",\"y\":" << y << "}\n";
+    log_.flush();
+}
+
+}
+}
+}
+}
diff --git a/src/autoapp/Projection/AurigaSession.cpp b/src/autoapp/Projection/AurigaSession.cpp
new file mode 100644
index 0000000..ba0db47
--- /dev/null
+++ b/src/autoapp/Projection/AurigaSession.cpp
@@ -0,0 +1,285 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture session: id minting, `current` pointer, manifest and
+*  retention. The on-disk contract is documented in
+*  `docs/Android Auto head unit.md`; the stream server follows it in
+*  `stream/lib/session.py`.
+*/
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#include <unistd.h>
+
+#include <f1x/openauto/Common/Log.hpp>
+#include <f1x/openauto/autoapp/Projection/AurigaSession.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+// One env read for the whole process. `AURIGA_CAPTURE_DIR` must be non-empty:
+// an exported empty value is treated as capture mode off, not as a half-on
+// headless process.
+const std::string& captureDirectory()
+{
+    static const std::string dir = []() {
+        const char* value = std::getenv("AURIGA_CAPTURE_DIR");
+        if (value == nullptr || *value == '\0')
+        {
+            return std::string();
+        }
+
+        std::error_code error;
+        std::filesystem::create_directories(value, error);
+        if (error)
+        {
+            OPENAUTO_LOG(warning) << "[AurigaSession] cannot create capture dir " << value << ": "
+                                  << error.message();
+        }
+
+        return std::string(value);
+    }();
+
+    return dir;
+}
+
+bool captureModeEnabled()
+{
+    return !captureDirectory().empty();
+}
+
+namespace
+{
+
+constexpr const char* kSessionPrefix = "session-";
+constexpr const char* kCurrentName = "current";
+constexpr const char* kManifestName = "manifest.json";
+constexpr const char* kStreams[] = {"video", "audio-media", "audio-guidance", "audio-system"};
+
+std::string timestampId()
+{
+    const std::time_t now = std::time(nullptr);
+    std::tm local{};
+    localtime_r(&now, &local);
+
+    char buffer[32] = {0};
+    std::strftime(buffer, sizeof(buffer), "%Y%m%d-%H%M%S", &local);
+    return std::string(buffer);
+}
+
+// Session ids sort lexicographically by time; a second entity inside the same
+// second gets a numeric suffix instead of sharing a directory.
+std::string mintSessionId(const std::string& captureDir)
+{
+    const std::string base = timestampId();
+    std::string candidate = base;
+
+    for (int suffix = 2; suffix < 100; ++suffix)
+    {
+        std::error_code error;
+        if (!std::filesystem::exists(captureDir + "/" + kSessionPrefix + candidate, error))
+        {
+            break;
+        }
+        candidate = base + "-" + std::to_string(suffix);
+    }
+
+    return candidate;
+}
+
+}
+
+AurigaSessionManager::AurigaSessionManager(std::string captureDir, uint32_t width, uint32_t height,
+                                           double fps, std::size_t keepSessions)
+    : captureDir_(std::move(captureDir))
+    , width_(width)
+    , height_(height)
+    , fps_(fps)
+    , keepSessions_(keepSessions)
+{
+    std::error_code error;
+    std::filesystem::create_directories(captureDir_, error);
+    if (error)
+    {
+        OPENAUTO_LOG(error) << "[AurigaSession] cannot create " << captureDir_ << ": "
+                            << error.message();
+    }
+
+    sessionId_ = mintSessionId(captureDir_);
+    directory_ = captureDir_ + "/" + kSessionPrefix + sessionId_;
+
+    std::filesystem::create_directories(directory_, error);
+    if (error)
+    {
+        OPENAUTO_LOG(error) << "[AurigaSession] cannot create " << directory_ << ": "
+                            << error.message();
+    }
+
+    for (const char* stream : kStreams)
+    {
+        segments_[stream] = 0;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        this->writeManifest();
+    }
+
+    this->publishCurrent();
+    this->prune();
+
+    OPENAUTO_LOG(info) << "[AurigaSession] session " << sessionId_ << " in " << directory_;
+}
+
+const std::string& AurigaSessionManager::sessionId() const
+{
+    return sessionId_;
+}
+
+const std::string& AurigaSessionManager::directory() const
+{
+    return directory_;
+}
+
+std::string AurigaSessionManager::path(const std::string& fileName) const
+{
+    return directory_ + "/" + fileName;
+}
+
+void AurigaSessionManager::noteRotation(const std::string& stream)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+
+    auto entry = segments_.find(stream);
+    if (entry == segments_.end())
+    {
+        OPENAUTO_LOG(warning) << "[AurigaSession] unknown stream " << stream;
+        return;
+    }
+
+    ++entry->second;
+    this->writeManifest();
+    OPENAUTO_LOG(info) << "[AurigaSession] " << stream << " segment " << entry->second;
+}
+
+// Caller holds mutex_. The manifest is replaced by rename so the stream server
+// never reads a half-written document.
+void AurigaSessionManager::writeManifest()
+{
+    std::ostringstream json;
+    json << "{\"session\":\"" << sessionId_ << "\""
+         << ",\"width\":" << width_ << ",\"height\":" << height_ << ",\"fps\":" << fps_;
+    for (const auto& entry : segments_)
+    {
+        json << ",\"" << entry.first << "\":" << entry.second;
+    }
+    json << "}\n";
+
+    const std::string path = directory_ + "/" + kManifestName;
+    const std::string temp = path + ".tmp";
+
+    {
+        std::ofstream file(temp, std::ios::out | std::ios::trunc | std::ios::binary);
+        if (!file.is_open())
+        {
+            OPENAUTO_LOG(error) << "[AurigaSession] cannot write " << temp;
+            return;
+        }
+        file << json.str();
+        file.flush();
+    }
+
+    if (std::rename(temp.c_str(), path.c_str()) != 0)
+    {
+        OPENAUTO_LOG(error) << "[AurigaSession] cannot publish " << path;
+    }
+}
+
+// Relative symlink replaced by rename: a reader either sees the old or the new
+// session, never a missing pointer.
+void AurigaSessionManager::publishCurrent()
+{
+    const std::string link = captureDir_ + "/" + kCurrentName;
+    const std::string temp = link + ".tmp." + std::to_string(::getpid());
+    const std::string target = kSessionPrefix + sessionId_;
+
+    ::unlink(temp.c_str());
+    if (::symlink(target.c_str(), temp.c_str()) != 0)
+    {
+        OPENAUTO_LOG(error) << "[AurigaSession] cannot create symlink " << temp;
+        return;
+    }
+
+    if (std::rename(temp.c_str(), link.c_str()) != 0)
+    {
+        OPENAUTO_LOG(error) << "[AurigaSession] cannot publish " << link;
+        ::unlink(temp.c_str());
+    }
+}
+
+void AurigaSessionManager::prune()
+{
+    std::vector<std::string> sessions;
+    std::error_code error;
+
+    for (const auto& entry : std::filesystem::directory_iterator(captureDir_, error))
+    {
+        const std::string name = entry.path().filename().string();
+        if (name.rfind(kSessionPrefix, 0) != 0 || name.size() <= std::strlen(kSessionPrefix))
+        {
+            continue;
+        }
+        if (!entry.is_directory(error))
+        {
+            continue;
+        }
+        sessions.push_back(name);
+    }
+
+    std::sort(sessions.begin(), sessions.end());
+
+    const std::size_t keep = keepSessions_ == 0 ? 1 : keepSessions_;
+    const std::size_t first = sessions.size() > keep ? sessions.size() - keep : 0;
+    const std::string current = kSessionPrefix + sessionId_;
+
+    for (std::size_t index = 0; index < first; ++index)
+    {
+        if (sessions[index] == current)
+        {
+            continue;
+        }
+
+        error.clear();
+        const auto removed = std::filesystem::remove_all(captureDir_ + "/" + sessions[index], error);
+        if (error)
+        {
+            OPENAUTO_LOG(warning) << "[AurigaSession] cannot prune " << sessions[index] << ": "
+                                  << error.message();
+        }
+        else
+        {
+            OPENAUTO_LOG(info) << "[AurigaSession] pruned " << sessions[index] << " ("
+                               << removed << " entries)";
+        }
+    }
+}
+
+}
+}
+}
+}
