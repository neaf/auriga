+++ b/include/f1x/openauto/autoapp/Projection/AurigaVideoOutput.hpp
@@ -0,0 +1,78 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture output: appends H.264 Annex-B access units to the current
+*  session's video.h264, rotating to a new segment before 4 GiB. The AA callback
+*  only queues a copy; a writer thread does the file I/O. Codec config (SPS/PPS)
+*  is cached separately and written at the head of each segment, or appended at
+*  the current offset when the phone sends it after the first access unit. When
+*  the queue overflows, the writer skips deltas until the next IDR instead of
+*  writing frames that reference a lost one.
+*/
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <fstream>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <f1x/openauto/autoapp/Projection/AurigaSession.hpp>
+#include <f1x/openauto/autoapp/Projection/AurigaWriter.hpp>
+#include <f1x/openauto/autoapp/Projection/VideoOutput.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+class AurigaVideoOutput : public VideoOutput
+{
+public:
+    AurigaVideoOutput(configuration::IConfiguration::Pointer configuration,
+                      std::shared_ptr<AurigaSessionManager> session);
+    ~AurigaVideoOutput() override;
+
+    bool open() override;
+    bool init() override;
+    void write(aasdk::messenger::Timestamp::ValueType timestamp,
+               const aasdk::common::DataConstBuffer& buffer) override;
+    void setCodecConfig(const aasdk::common::DataConstBuffer& buffer) override;
+    void stop() override;
+
+private:
+    // Runs on the writer thread only.
+    void writeChunk(const std::vector<uint8_t>& chunk);
+    void rotate();
+    // Writer thread: copy the cached SPS/PPS into the file at the current
+    // offset. Returns false when no codec config has been seen yet.
+    bool writeCachedCodecConfig();
+
+    std::shared_ptr<AurigaSessionManager> session_;
+    std::string path_;
+    std::ofstream file_;
+    std::vector<uint8_t> codecConfig_;
+    std::mutex codecConfigMutex_;
+    std::atomic<bool> codecConfigPending_;
+    uint64_t segmentBytes_;
+    bool segmentStarted_;
+    bool codecConfigWritten_;
+    bool awaitingKeyframe_;
+    bool warnedMissingConfig_;
+    bool accepting_;
+    // Declared last: its destructor joins the writer thread before the file and
+    // the codec-config buffer are destroyed.
+    AurigaWriter writer_;
+};
+
+}
+}
+}
+}
diff --git a/include/f1x/openauto/autoapp/Projection/AurigaWriter.hpp b/include/f1x/openauto/autoapp/Projection/AurigaWriter.hpp
new file mode 100644
index 0000000..66b4fd5
--- /dev/null
+++ b/include/f1x/openauto/autoapp/Projection/AurigaWriter.hpp
@@ -0,0 +1,234 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture writer: a bounded in-memory queue plus one writer thread. The
+*  AA media callback only copies its buffer into the queue, so no file I/O ever
+*  runs on the channel strand; the writer thread drains the queue to the
+*  segment file, where rotation and WAV header rewrites happen too.
+*/
+
+#pragma once
+
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <aasdk/Common/Data.hpp>
+
+#include <f1x/openauto/Common/Log.hpp>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+class AurigaWriter
+{
+public:
+    using Sink = std::function<void(const std::vector<uint8_t>&)>;
+
+    // High-water mark: ~8 s of video at 30 fps, with a byte cap so a burst of
+    // large access units cannot grow the process without bound.
+    static constexpr std::size_t MAX_CHUNKS = 240;
+    static constexpr std::size_t MAX_BYTES = 64ull * 1024ull * 1024ull;
+
+    AurigaWriter(std::string stream, Sink sink)
+        : stream_(std::move(stream))
+        , sink_(std::move(sink))
+        , queuedBytes_(0)
+        , dropped_(0)
+        , gap_(false)
+        , stopping_(false)
+    {
+    }
+
+    ~AurigaWriter()
+    {
+        this->stop();
+    }
+
+    AurigaWriter(const AurigaWriter&) = delete;
+    AurigaWriter& operator=(const AurigaWriter&) = delete;
+
+    void start()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+
+        if (thread_.joinable() || stopping_)
+        {
+            return;
+        }
+
+        thread_ = std::thread([this]() { this->run(); });
+    }
+
+    // Copy the buffer into the queue and return. This is the only work the
+    // channel strand does for a media buffer; when the queue is full the oldest
+    // chunk is dropped and counted instead of blocking the strand.
+    void append(const aasdk::common::DataConstBuffer& buffer)
+    {
+        if (buffer.cdata == nullptr || buffer.size == 0)
+        {
+            return;
+        }
+
+        std::vector<uint8_t> chunk(static_cast<std::size_t>(buffer.size));
+        std::memcpy(chunk.data(), buffer.cdata, chunk.size());
+
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+
+            if (stopping_)
+            {
+                return;
+            }
+
+            while (!queue_.empty() &&
+                   (queue_.size() >= MAX_CHUNKS || queuedBytes_ + chunk.size() > MAX_BYTES))
+            {
+                this->dropOldestLocked();
+            }
+
+            if (queue_.size() >= MAX_CHUNKS || queuedBytes_ + chunk.size() > MAX_BYTES)
+            {
+                // A single chunk larger than the byte cap: drop it, keep serving.
+                this->countDropLocked();
+                return;
+            }
+
+            queuedBytes_ += chunk.size();
+            queue_.push_back(std::move(chunk));
+        }
+
+        condition_.notify_one();
+    }
+
+    // Drain what is still queued, then join the writer thread. Called once, at
+    // sink stop; blocking here is shutdown, not the media path.
+    void stop()
+    {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            stopping_ = true;
+        }
+
+        condition_.notify_all();
+
+        if (thread_.joinable())
+        {
+            thread_.join();
+        }
+    }
+
+    uint64_t dropped() const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return dropped_;
+    }
+
+    // True when a chunk was dropped since the last call. A sink that writes a
+    // reference-based stream uses this to resynchronise (video: skip deltas and
+    // restart at the next IDR) instead of writing frames with a lost reference.
+    bool take_drop_flag()
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        const bool dropped = gap_;
+        gap_ = false;
+        return dropped;
+    }
+
+    const std::string& stream() const
+    {
+        return stream_;
+    }
+
+private:
+    void run()
+    {
+        for (;;)
+        {
+            std::vector<uint8_t> chunk;
+
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                condition_.wait(lock, [this]() { return stopping_ || !queue_.empty(); });
+
+                if (queue_.empty())
+                {
+                    if (stopping_)
+                    {
+                        return;
+                    }
+                    continue;
+                }
+
+                chunk = std::move(queue_.front());
+                queue_.pop_front();
+                queuedBytes_ -= chunk.size();
+            }
+
+            if (!sink_)
+            {
+                continue;
+            }
+
+            try
+            {
+                sink_(chunk);
+            }
+            catch (...)
+            {
+                OPENAUTO_LOG(error) << "[AurigaWriter] " << stream_ << " write failed";
+            }
+        }
+    }
+
+    void dropOldestLocked()
+    {
+        queuedBytes_ -= queue_.front().size();
+        queue_.pop_front();
+        this->countDropLocked();
+    }
+
+    // Caller holds mutex_. Log the first drop and then every 100th, so a stalled
+    // writer is visible in the log without flooding it.
+    void countDropLocked()
+    {
+        ++dropped_;
+        gap_ = true;
+        if (dropped_ == 1 || dropped_ % 100 == 0)
+        {
+            OPENAUTO_LOG(warning) << "[AurigaWriter] " << stream_ << " queue full, dropped "
+                                  << dropped_ << " chunk(s)";
+        }
+    }
+
+    std::string stream_;
+    Sink sink_;
+
+    mutable std::mutex mutex_;
+    std::condition_variable condition_;
+    std::deque<std::vector<uint8_t>> queue_;
+    uint64_t queuedBytes_;
+    uint64_t dropped_;
+    bool gap_;
+    bool stopping_;
+    std::thread thread_;
+};
+
+}
+}
+}
+}
