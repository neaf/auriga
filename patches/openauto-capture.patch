@@ -0,0 +1,61 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture session: one session per AA entity. Mints the id, creates
+*  <capture-dir>/session-<id>/, publishes <capture-dir>/current and owns
+*  manifest.json (per-stream segment counts) plus the retention cap.
+*/
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+class AurigaSessionManager
+{
+public:
+    // A stream file is truncated and restarted before it can reach 4 GiB; the
+    // WAV header carries 32-bit RIFF sizes and must never wrap.
+    static constexpr uint64_t SEGMENT_LIMIT = (4ull << 30) - (16ull << 20);
+    // Most recent sessions kept on disk; the current one is never pruned.
+    static constexpr std::size_t KEEP_SESSIONS = 5;
+
+    AurigaSessionManager(std::string captureDir, std::size_t keepSessions = KEEP_SESSIONS);
+
+    const std::string& sessionId() const;
+    const std::string& directory() const;
+    std::string path(const std::string& fileName) const;
+    // Called by a sink after it restarted its file: bumps that stream's segment
+    // count and republishes manifest.json atomically.
+    void noteRotation(const std::string& stream);
+
+private:
+    void writeManifest();
+    void publishCurrent();
+    void prune();
+
+    std::string captureDir_;
+    std::string sessionId_;
+    std::string directory_;
+    std::size_t keepSessions_;
+    std::map<std::string, uint64_t> segments_;
+    std::mutex mutex_;
+};
+
+}
+}
+}
+}
