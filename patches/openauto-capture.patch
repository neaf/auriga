@@ -0,0 +1,76 @@
+/*
+*  This file is part of openauto project.
+*
+*  Auriga capture session: one session per AA entity. Mints the id, creates
+*  <capture-dir>/session-<id>/, publishes <capture-dir>/current and owns
+*  manifest.json (geometry, per-stream segment counts) plus the retention cap.
+*  This header also holds the one definition of capture mode.
+*/
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace f1x
+{
+namespace openauto
+{
+namespace autoapp
+{
+namespace projection
+{
+
+// Capture mode is opt-in and has exactly one definition: AURIGA_CAPTURE_DIR is
+// set and non-empty. The environment is read once; both App and ServiceFactory
+// branch on these two helpers.
+bool captureModeEnabled();
+// The capture directory, created on first use; empty when capture mode is off.
+const std::string& captureDirectory();
+
+class AurigaSessionManager
+{
+public:
+    // A stream file is truncated and restarted before it can reach 4 GiB; the
+    // WAV header carries 32-bit RIFF sizes and must never wrap.
+    static constexpr uint64_t SEGMENT_LIMIT = (4ull << 30) - (16ull << 20);
+    // Most recent sessions kept on disk; the current one is never pruned.
+    static constexpr std::size_t KEEP_SESSIONS = 5;
+
+    // `width`, `height` and `fps` are the AA video geometry the phone is told to
+    // use; they are published in manifest.json so the stream server and the
+    // browser do not have to guess.
+    AurigaSessionManager(std::string captureDir, uint32_t width, uint32_t height, double fps,
+                         std::size_t keepSessions = KEEP_SESSIONS);
+
+    const std::string& sessionId() const;
+    const std::string& directory() const;
+    std::string path(const std::string& fileName) const;
+    // Called by a sink after it restarted its file: bumps that stream's segment
+    // count and republishes manifest.json atomically.
+    void noteRotation(const std::string& stream);
+
+private:
+    void writeManifest();
+    void publishCurrent();
+    void prune();
+
+    std::string captureDir_;
+    std::string sessionId_;
+    std::string directory_;
+    uint32_t width_;
+    uint32_t height_;
+    double fps_;
+    std::size_t keepSessions_;
+    std::map<std::string, uint64_t> segments_;
+    std::mutex mutex_;
+};
+
+}
+}
+}
+}
diff --git a/include/f1x/openauto/autoapp/Projection/AurigaVideoOutput.hpp b/include/f1x/openauto/autoapp/Projection/AurigaVideoOutput.hpp
new file mode 100644
index 0000000..e15704c
